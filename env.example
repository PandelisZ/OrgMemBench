# OrgMemBench API keys.  Copy this to `.env` (which is gitignored) and fill in
# the real values:   cp env.example .env   then edit .env
#
# `.env` is loaded automatically by run_plan.sh. Keys NEVER go in git or chat.
# ---------------------------------------------------------------------------
# WHO PAYS WHAT (small tier runs all six systems, so all of these are used):
#   ANTHROPIC_API_KEY   judge + the answerers + every system's LLM
#                       + gbrain's `think` model.  REQUIRED.
#   OPENAI_API_KEY      embeddings for mem0 (OSS) and graphiti.
#   MEM0_API_KEY        Mem0 Platform (hosted).  FREE tier covers all tiers.
#   ZEP_API_KEY         Zep Cloud (hosted).      FREE tier covers small.
#   ZEROENTROPY_API_KEY gbrain's recommended embeddings + zerank-2 reranker.
#                       (Optional: gbrain can fall back to OPENAI_API_KEY, but
#                        ZeroEntropy is gbrain's recommended config.)
# ---------------------------------------------------------------------------

# --- you provide these (external services) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MEM0_API_KEY=
ZEP_API_KEY=
ZEROENTROPY_API_KEY=

# --- Claude manages these (local services); leave as-is unless you change them ---
# Neo4j for graphiti — stood up locally via `docker compose up -d neo4j`.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=orgmembench-local
